              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data=pm.response.json(); const token=data.token || data.access_token; if(token) pm.collectionVariables.set('token',token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
